<srcSchema _cs="Test Woo Target Sample (wootar)" created="2026-08-18 07:00:01.952Z"
           createdBy-id="0" entitySchema="xtk:srcSchema" img="xtk:schema.png" label="Test Woo Target Sample"
           labelSingular="Test Woo Target Sample" lastModified="2026-08-24 04:00:00.000Z"
           mappingType="sql" md5="59DAA9BCF68A530F844606157765B316" modifiedBy-id="0"
           name="testWooTargetSample" namespace="wootar" xtkschema="xtk:srcSchema">
  <createdBy _cs="우해인 (hiwoo)"/>
  <modifiedBy _cs="우해인 (hiwoo)"/>

  <!-- 마케팅 수신동의 열거형 -->
  <enumeration basetype="string" label="마켓팅수신동의" name="mConsentEnum">
    <value label="동의" name="agreed" value="동의"/>
    <value label="미동의" name="disagreed" value="미동의"/>
  </enumeration>

  <!-- Target API 전송여부 열거형 -->
  <enumeration basetype="string" label="API전송여부" name="apiYnEnum">
    <value label="미전송" name="no" value="N"/>
    <value label="전송완료" name="yes" value="Y"/>
  </enumeration>

  <element autopk="true" label="Test Woo Target Sample" name="testWooTargetSample">

    <!-- 큐 행 유니크. UID는 적재일·세그마다 여러 행 가능 -->
    <key name="queueLine">
      <keyfield xpath="@ingestYmd"/>
      <keyfield xpath="@lineNo"/>
    </key>

    <!-- 멤버십 UID. Target thirdPartyId. 유니크 아님. 조회용 인덱스만 -->
    <attribute desc="고객 멤버십 식별자. 동일 UID 복수 행 허용" label="멤버십UID" length="10" name="membershipUid"
               notNull="true" type="string"/>

    <!-- 전송 큐 키 — 적재월일. 포맷 YYYYMMDD (8자리 숫자, 예: 20260824).
         Factory BIZ_DATE(기준일)와 일치하는 행만 pending·전송 대상.
         기존 테이블에 행이 있으면 notNull 추가 시 PGS-220000 → nullable 유지, 백필 후 적재. -->
    <attribute desc="적재월일 YYYYMMDD. 일 단위 큐 파티션. Factory 기준일과 비교" label="적재월일" length="8"
               name="ingestYmd" type="string"/>
    <attribute desc="적재일 내 전송 일련. 1부터. 기존 행 Default 0 이면 queueLine 유니크 충돌" label="큐일련"
               name="lineNo" type="long"/>

    <!-- 마케팅 수신동의 -->
    <attribute desc="마케팅 수신 동의 여부" enum="mConsentEnum" label="마케팅수신동의" length="10"
               name="mConsent" type="string"/>

    <!-- 요금제 코드 -->
    <attribute desc="5G 요금제 코드" label="요금제코드" length="20" name="planCode" type="string"/>

    <!-- 요금제명 -->
    <attribute desc="요금제 명칭" label="요금제명" length="50" name="planName" type="string"/>

    <!-- 전화번호 -->
    <attribute desc="고객 휴대전화번호" label="전화번호" length="11" name="phoneNumber" type="string"/>

    <!-- 발송최적시간 -->
    <attribute desc="메시지 발송 최적 시간 (HH:MM)" label="발송최적시간" length="5" name="optimalSendTime"
               type="string"/>

    <!-- 생성/수정 정보 -->
    <attribute desc="레코드 생성 일시" label="생성일" name="created" sqlDefault="GetDate()"
               type="datetime"/>
    <attribute desc="레코드 최종 수정 일시" label="수정일" name="lastModified" type="datetime"/>

    <!-- 타겟 API 전송여부. N=미전송 / Y=전송완료 -->
    <attribute desc="Target Bulk API 전송 여부" enum="apiYnEnum" label="API 전송여부" length="1"
               name="apiYn" notNull="true" sqlDefault="'N'" type="string"/>

    <!-- 세그 목록. 파이프 구분. 사전 적재(배치 잡/SQL). 워커는 읽기만 -->
    <attribute desc="세그 식별자 파이프 구분 목록. 사전 적재" label="세그ID" length="255" name="segId"
               type="string"/>

    <!-- 전송 배치 FK. 0 = 미전송(어떤 배치와도 미연결). Campaign numeric은 NULL 불가 -->
    <element externalJoin="true" integrity="neutral" label="전송배치" name="master" revIntegrity="neutral"
             revLabel="전송큐행" revLink="targetSample" target="wootar:testWooTargetBulkApiMaster"
             type="link"/>
    
  
    <!-- apiYn 선행. pending 조회 조건 순서와 idx_pending_queue 일치 -->
    <dbindex name="idx_pending_queue">
      <keyfield xpath="@apiYn"/>
      <keyfield xpath="@ingestYmd"/>
      <keyfield xpath="@lineNo"/>
    </dbindex>
    
    <!-- apiYn 선행. pending 조회 조건 순서와 idx_pending_queue 일치 -->
    <dbindex name="idx_pending_queue">
      <keyfield xpath="@apiYn"/>
      <keyfield xpath="@ingestYmd"/>
      <keyfield xpath="@lineNo"/>
    </dbindex>
    
    <!-- 멤버십 UID 조회용. -->
    <dbindex name="idx_membershipUid">
      <keyfield xpath="@membershipUid"/>
    </dbindex>
    
    <!-- 큐 일련번호 조회용. -->
    <dbindex name="idx_lineNo">
      <keyfield xpath="@lineNo"/>
    </dbindex>

  </element>
</srcSchema>
